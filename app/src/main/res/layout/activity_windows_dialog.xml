<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Windows Quotes" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <ImageView android:id="@+id/ivDialogPreview" android:layout_width="match_parent" android:layout_height="280dp" android:scaleType="fitCenter" android:background="@drawable/bg_video_border" />

        <EditText android:id="@+id/etDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Title bar text" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <EditText android:id="@+id/etDialogMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Message text" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:minLines="2" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnTypeInfo" style="@style/Widget.AppCompat.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Info" android:background="@drawable/bg_button_outline_cyan" android:textColor="@color/text_white" />
            <Button android:id="@+id/btnTypeWarning" style="@style/Widget.AppCompat.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:text="Warning" android:background="@drawable/bg_button_outline_cyan" android:textColor="@color/text_white" />
            <Button android:id="@+id/btnTypeError" style="@style/Widget.AppCompat.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Error" android:background="@drawable/bg_button_outline_cyan" android:textColor="@color/text_white" />
        </LinearLayout>

        <Button android:id="@+id/btnSaveDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save to Gallery" android:backgroundTint="@color/neon_cyan" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />
        <Button android:id="@+id/btnShareDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Share" android:backgroundTint="@color/neon_purple" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>