<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:tint="@color/neon_cyan"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Network Scan"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp"
                android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvLocalIpInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your IP: --"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/tvGatewayInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gateway: --"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/tvSubnetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Subnet Mask: --"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/tvDnsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="DNS: --"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLastScanInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="No previous scan found"
            android:textColor="#666666"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed" />

        <Button
            android:id="@+id/btnStartScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start Scan"
            android:backgroundTint="@color/neon_cyan"
            android:textColor="@color/text_white"
            android:fontFamily="sans-serif-condensed" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/neon_cyan"
            android:progressBackgroundTint="#2A2A38"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tap Start Scan to find devices on your WiFi"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" />

        <LinearLayout
            android:id="@+id/filterSortRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnToggleFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Show All"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed" />

            <Button
                android:id="@+id/btnToggleSort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Sort: Default"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/btnExportResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export Results"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>