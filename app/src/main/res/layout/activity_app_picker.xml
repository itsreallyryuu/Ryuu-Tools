<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:tint="@color/neon_purple"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Add Game / App"
            android:textColor="@color/neon_cyan"
            android:textSize="18sp"
            android:fontFamily="@font/orbitron_bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/etSearchApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:hint="Search installed apps..."
        android:textColorHint="#666666"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-condensed"
        android:background="@drawable/bg_card_rounded"
        android:padding="12dp"
        android:inputType="text"
        android:singleLine="true" />

    <ProgressBar
        android:id="@+id/progressLoadingApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:indeterminateTint="@color/neon_purple" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInstalledApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp" />

</LinearLayout>