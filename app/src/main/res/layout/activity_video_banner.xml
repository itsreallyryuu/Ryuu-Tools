<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Video Banner" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <TextView android:id="@+id/rowBanner1" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Banner 1 (Default)" android:textColor="@color/text_white" android:background="@drawable/bg_card_rounded" android:layout_marginBottom="8dp" android:fontFamily="sans-serif-condensed" />
        <TextView android:id="@+id/rowBanner2" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Banner 2" android:textColor="@color/text_white" android:background="@drawable/bg_card_rounded" android:layout_marginBottom="8dp" android:fontFamily="sans-serif-condensed" />
        <TextView android:id="@+id/rowBanner3" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Banner 3" android:textColor="@color/text_white" android:background="@drawable/bg_card_rounded" android:layout_marginBottom="16dp" android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Tip: use a landscape (horizontal) video for the best fit — portrait videos will look cropped or letterboxed."
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed" />

        <Button android:id="@+id/btnUploadCustom" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upload Your Own Video" android:backgroundTint="@color/neon_cyan" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>