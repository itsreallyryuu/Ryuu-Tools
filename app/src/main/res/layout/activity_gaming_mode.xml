<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Gaming Mode" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="18dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvGamingStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gaming Mode: OFF" android:textColor="@color/text_white" android:textSize="16sp" android:fontFamily="@font/orbitron_bold" />
                <Switch android:id="@+id/switchGamingMaster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" android:scaleX="1.3" android:scaleY="1.3" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Applies the options below while you're gaming, and reverts everything automatically when turned off." android:textColor="#888888" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginStart="4dp" android:text="Boosted Apps" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginTop="10dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Add games or apps here — tapping one launches it with Gaming Mode turned on automatically." android:textColor="#888888" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />

            <TextView android:id="@+id/tvNoBoostedApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="12dp" android:text="No apps added yet" android:textColor="#666666" android:textSize="12sp" android:fontFamily="sans-serif-condensed" android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBoostedApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />

            <Button android:id="@+id/btnAddBoostedApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Add Game / App" android:backgroundTint="@color/neon_purple" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginStart="4dp" android:text="Display &amp; Performance" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginTop="10dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Disable Animations" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchAnimations" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A38" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Force Max Refresh Rate" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchRefreshRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Note: refresh rate control may not work on all devices, especially those with heavily customized Android skins." android:textColor="#666666" android:textSize="10sp" android:fontFamily="sans-serif-condensed" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A38" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Force Max Brightness" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchMaxBrightness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A38" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Disable Battery Saver" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchDisableBatterySaver" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginStart="4dp" android:text="Focus &amp; Comfort" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginTop="10dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Do Not Disturb" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchDnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A38" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Extend Screen Timeout" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchScreenTimeout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A38" android:layout_marginVertical="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lock Screen Rotation" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchLockRotation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginStart="4dp" android:text="One-Time Actions" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginTop="10dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Clean Background Apps on Start" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
                <Switch android:id="@+id/switchCleanOnStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Runs once each time Gaming Mode is turned on — same background app cleanup used by Memory Sweep." android:textColor="#666666" android:textSize="10sp" android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>