<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="VPN" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_rounded" android:padding="14dp" android:layout_marginBottom="16dp" android:text="This is a local DNS-privacy + ad-block VPN. It encrypts and redirects your DNS queries and can block known ad/tracker domains. It does NOT change your public IP or unblock region-locked content — that needs a remote VPN server, which this app doesn't provide." android:textColor="#888888" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="18dp" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvVpnStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Disconnected" android:textColor="@color/text_white" android:textSize="16sp" android:fontFamily="@font/orbitron_bold" />
                <Switch android:id="@+id/switchVpn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" android:scaleX="1.3" android:scaleY="1.3" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Upstream DNS Server" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginBottom="16dp">
            <RadioGroup android:id="@+id/radioGroupDns" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/radioCloudflare" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cloudflare (1.1.1.1)" android:textColor="@color/text_white" android:checked="true" />
                <RadioButton android:id="@+id/radioGoogle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Google (8.8.8.8)" android:textColor="@color/text_white" />
                <RadioButton android:id="@+id/radioQuad9" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quad9 (9.9.9.9)" android:textColor="@color/text_white" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Block Ads &amp; Trackers" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="sans-serif-condensed" />
            <Switch android:id="@+id/switchAdBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumbTint="@color/switch_thumb_selector" android:trackTint="@color/switch_track_selector" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Session Stats" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/orbitron_bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp">
            <TextView android:id="@+id/tvQueryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DNS queries: 0" android:textColor="@color/text_white" android:textSize="13sp" android:fontFamily="sans-serif-condensed" android:layout_marginBottom="6dp" />
            <TextView android:id="@+id/tvBlockedCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blocked: 0" android:textColor="@color/neon_cyan" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>