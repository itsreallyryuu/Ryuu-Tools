<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="IQC Generator" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:background="@drawable/bg_video_border"
            android:padding="4dp">
            <ImageView
                android:id="@+id/ivChatPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <Spinner android:id="@+id/spinnerOperator" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" />
            <EditText android:id="@+id/etBattery" android:layout_width="80dp" android:layout_height="wrap_content" android:hint="71" android:inputType="number" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

        <EditText android:id="@+id/etChatTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Jam (misal 11:00)" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <EditText android:id="@+id/etChatMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Isi pesan" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:minLines="2" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="⚙️ Kalibrasi Posisi Bubble" android:textColor="@color/neon_purple" android:textSize="13sp" android:fontFamily="sans-serif-condensed" />

        <TextView android:id="@+id/tvStatusHLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tinggi Status Bar: 5%" android:textColor="@color/text_white" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />
        <SeekBar android:id="@+id/seekStatusH" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="20" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />

        <TextView android:id="@+id/tvBubbleLeftLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble Kiri: 6%" android:textColor="@color/text_white" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />
        <SeekBar android:id="@+id/seekBubbleLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />

        <TextView android:id="@+id/tvBubbleRightLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble Kanan: 94%" android:textColor="@color/text_white" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />
        <SeekBar android:id="@+id/seekBubbleRight" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />

        <TextView android:id="@+id/tvBubbleTopLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble Atas: 40%" android:textColor="@color/text_white" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />
        <SeekBar android:id="@+id/seekBubbleTop" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />

        <TextView android:id="@+id/tvBubbleBottomLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bubble Bawah: 50%" android:textColor="@color/text_white" android:textSize="12sp" android:fontFamily="sans-serif-condensed" />
        <SeekBar android:id="@+id/seekBubbleBottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progressTint="@color/neon_cyan" android:thumbTint="@color/neon_cyan" />

        <Button android:id="@+id/btnSaveChat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Download Gambar" android:backgroundTint="@color/neon_cyan" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>