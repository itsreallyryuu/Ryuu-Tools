<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="30dp" android:layout_height="30dp" android:background="@android:color/transparent" android:src="@drawable/ic_back" android:tint="@color/neon_cyan" android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Profile Card Fake" android:textColor="@color/neon_cyan" android:textSize="18sp" android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="Untuk hiburan/desain saja — hasil gambar otomatis dikasih watermark, jangan dipakai buat niru identitas orang lain." android:textColor="#888888" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />

        <ImageView android:id="@+id/ivProfilePreview" android:layout_width="match_parent" android:layout_height="280dp" android:scaleType="fitCenter" android:background="@drawable/bg_video_border" />

        <EditText android:id="@+id/etProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Nama fiktif" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <EditText android:id="@+id/etProfileHandle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@username" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <EditText android:id="@+id/etProfileBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Bio singkat" android:textColorHint="#888888" android:textColor="@color/text_white" android:padding="14dp" android:background="@drawable/bg_card_rounded" android:fontFamily="sans-serif-condensed" />

        <Button android:id="@+id/btnSaveProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save to Gallery" android:backgroundTint="@color/neon_cyan" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />
        <Button android:id="@+id/btnShareProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Share" android:backgroundTint="@color/neon_purple" android:textColor="@color/text_white" android:fontFamily="sans-serif-condensed" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>