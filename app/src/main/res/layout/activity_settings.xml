<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:tint="@color/neon_cyan"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Back"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Settings"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:fontFamily="@font/orbitron_bold" />
        </LinearLayout>

        <!-- SECTION: UPDATES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATES"
            android:textColor="#666666"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-condensed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v--"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-condensed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Automatic Update Checks"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" />
                <Switch
                    android:id="@+id/switchAutoUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb_selector"
                    android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A38"
                android:layout_marginVertical="14dp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check for Updates"
                android:backgroundTint="@color/neon_cyan"
                android:textColor="@color/text_white"
                android:fontFamily="sans-serif-condensed" />

            <ProgressBar
                android:id="@+id/progressCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/neon_cyan"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Tap the button above to check manually"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <!-- SECTION: BACKGROUND ALERTS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACKGROUND ALERTS"
            android:textColor="#666666"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-condensed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overheat Alerts"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed" />
                <Switch
                    android:id="@+id/switchThermalAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb_selector"
                    android:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Checks device temperature every 15 minutes in the background"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

        <!-- SECTION: MORE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MORE"
            android:textColor="#666666"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-condensed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/btnAbout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="About Ryuu Tools"
    android:drawableStart="@drawable/ic_info"
    android:drawableTint="@color/neon_cyan"
    android:drawablePadding="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical|start"
    android:background="@drawable/bg_button_outline_cyan"
    app:backgroundTint="@null"
    android:textColor="@color/text_white"
    android:textAllCaps="false"
    android:fontFamily="sans-serif-condensed" />

<androidx.appcompat.widget.AppCompatButton
    android:id="@+id/btnFeedback"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Send Feedback"
    android:drawableStart="@drawable/ic_whatsapp"
    android:drawableTint="@color/neon_cyan"
    android:drawablePadding="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical|start"
    android:background="@drawable/bg_button_outline_cyan"
    app:backgroundTint="@null"
    android:textColor="@color/text_white"
    android:textAllCaps="false"
    android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>