<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live Stats"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed" />
        <TextView
            android:id="@+id/overlayCloseButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="X"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/tvOverlayCpu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU: --%" android:textColor="@color/text_white" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />
    <TextView android:id="@+id/tvOverlayFps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS: --" android:textColor="@color/text_white" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />
    <TextView android:id="@+id/tvOverlayRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM: -- GB free" android:textColor="@color/text_white" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />
    <TextView android:id="@+id/tvOverlayTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp: --°C" android:textColor="@color/text_white" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />
    <TextView android:id="@+id/tvOverlayNet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Net: -- / -- KB/s" android:textColor="@color/text_white" android:textSize="11sp" android:fontFamily="sans-serif-condensed" />

</LinearLayout>